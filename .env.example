# ==============================================================================
# .env.example – Mẫu biến môi trường cho Real-time Lpr Recognition System
# Sao chép file này thành .env rồi điền giá trị thật trước khi chạy hệ thống.
#   cp .env.example .env
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# Database PostgreSQL
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://your_user:your_password@postgres_db:5432/license_plate_recognition_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_MULTIPLE_DATABASES=license_plate_recognition_db
POSTGRES_DB=license_plate_recognition_db
POSTGRES_ADMIN_PASSWORD=your_admin_password

# ──────────────────────────────────────────────────────────────────────────────
# JWT Security
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your_jwt_secret_key_change_this
JWT_ALGORITHM=HS256

# ──────────────────────────────────────────────────────────────────────────────
# RabbitMQ (Message Broker)
# ──────────────────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
RABBITMQ_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@rabbitmq:5672/
RABBITMQ_ERLANG_COOKIE=your_erlang_cookie

# ──────────────────────────────────────────────────────────────────────────────
# MinIO (Object Storage)
# ──────────────────────────────────────────────────────────────────────────────
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=license_plate-recognition-images

# ──────────────────────────────────────────────────────────────────────────────
# Redis (Cache & Pub/Sub)
# ──────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/
REDIS_PASSWORD=your_redis_password

# ──────────────────────────────────────────────────────────────────────────────
# GHCR.io (GitHub Container Registry – cho CI/CD)
# ──────────────────────────────────────────────────────────────────────────────
GHCR_USERNAME=your_github_username
GHCR_TOKEN=ghp_your_github_personal_access_token
GHCR_EMAIL=your_email@example.com
