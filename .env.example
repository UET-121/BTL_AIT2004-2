# Copy to .env and adjust

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plate_recognition

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/plate_recognition
REDIS_URL=redis://localhost:6379/0
STORAGE_TYPE=local
UPLOAD_DIR=uploads
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
LOG_LEVEL=INFO

# MinIO configuration
MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads

# Recognition — Detection
TARGET_FPS=10.0
USE_PLATE_DETECTION=true
PLATE_DETECTION_MODEL=license_plate_detector.pt
PLATE_DETECTION_CONFIDENCE=0.5
USE_ONNX_INFERENCE=true
ONNX_MODEL_PATH=models/onnx/yolov8-plate-v1.onnx

# Recognition — OCR
OCR_MIN_CONFIDENCE=0.3
OCR_GPU=true

# Recognition — Thresholds & Retry
NEEDS_REVIEW_THRESHOLD=0.6
AUTO_ACCEPT_THRESHOLD=0.85
ENABLE_ENHANCED_RETRY=true
MAX_PROCESSING_ATTEMPTS=3
DEFAULT_PLATE_REGION=GB

# Frontend Configuration
VITE_API_URL=
BACKEND_PROXY_TARGET=http://api:8000
VITE_USE_DEMO_DATA=false
