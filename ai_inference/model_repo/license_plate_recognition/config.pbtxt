name: "license_plate_recognition"
platform: "tensorrt_plan"
max_batch_size: 8

input [
  {
    name: "input_1"
    data_type: TYPE_FP32
    dims: [ 112, 112, 3 ]
  }
]

output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [ 512 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  max_queue_delay_microseconds: 1000
}

instance_group [
  {
    count: 2
    kind: KIND_GPU
  }
]
