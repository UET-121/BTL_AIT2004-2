# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/plate_recognition

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# MinIO configuration
MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads


# CORS (JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Recognition — Detection
USE_PLATE_DETECTION=true
PLATE_DETECTION_MODEL=yolov8n.pt
PLATE_DETECTION_CONFIDENCE=0.5
USE_ONNX_INFERENCE=false
ONNX_MODEL_PATH=models/onnx/yolov8-plate-v1.onnx

# Recognition — OCR
OCR_MIN_CONFIDENCE=0.3
OCR_GPU=false

# Recognition — Confidence Thresholds
NEEDS_REVIEW_THRESHOLD=0.6
AUTO_ACCEPT_THRESHOLD=0.85

# Recognition — Retry
ENABLE_ENHANCED_RETRY=true
MAX_PROCESSING_ATTEMPTS=3

# Recognition — Validation
DEFAULT_PLATE_REGION=BR

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
DEBUG=false

# Worker model loading
FAIL_FAST_ON_MISSING_MODEL=false
